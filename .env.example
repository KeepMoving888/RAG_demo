# ============================================================
# Enterprise RAG Knowledge Base - 环境变量模板
# 复制本文件为 .env 后按实际环境填写
# ============================================================

# ======================== 应用 ========================
APP_NAME=Enterprise RAG Knowledge Base
APP_ENV=production
DEBUG=false

# ======================== PostgreSQL ========================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag123
POSTGRES_DB=rag_kb

# ======================== Redis ========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ======================== RabbitMQ (Celery Broker) ========================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=rag
RABBITMQ_PASSWORD=rag123

# ======================== Milvus 向量库 ========================
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=kb_chunks
MILVUS_DIMENSION=1024
# IVF_FLAT 索引参数 (调优: 数据量大时增大 nlist, 召回不足时增大 nprobe)
MILVUS_NLIST=128
MILVUS_NPROBE=16

# ======================== Neo4j 知识图谱 ========================
NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123

# ======================== LLM Provider ========================
# provider: offline (无需 API Key) / openai (OpenAI 兼容) / deepseek
LLM_PROVIDER=offline
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_REQUEST_TIMEOUT=60

# ======================== Embedding ========================
# 模型: BAAI/bge-m3 (1024 维)
# 设备: cpu / cuda / cuda:0 (GPU 推理可降至 < 30ms/query)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=32
# FP16 半精度 (GPU 下吞吐约 2x, 精度损失可忽略)
EMBEDDING_USE_FP16=true

# ======================== 后端服务 ========================
# Uvicorn Worker 数量 (生产建议 CPU 核数 * 2, 受 GIL 限制多 Worker 可线性提升 QPS)
UVICORN_WORKERS=4

# 连接池 (多 Worker 下需相应放大: 总连接 = workers * (pool_size + max_overflow))
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
REDIS_MAX_CONNECTIONS=64

# ======================== Reranker ========================
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MAX_LENGTH=512
# Cross-Encoder predict 单批大小 (4060Ti 16GB 可设 32)
RERANKER_BATCH_SIZE=32

# ======================== 检索参数 ========================
RETRIEVAL_RECALL_K=50
RETRIEVAL_TOP_K=5
RRF_K=60
BM25_K1=1.5
BM25_B=0.75

# ======================== 分块参数 ========================
CHUNK_SIZE=512
CHUNK_OVERLAP=64
CHUNK_MIN_SIZE=64

# ======================== 多轮对话 ========================
DIALOG_WINDOW_SIZE=6
DIALOG_MAX_TURNS=20
DIALOG_SESSION_TTL=3600

# ======================== 缓存 ========================
QA_CACHE_TTL=3600
QA_CACHE_MAX_KEYS=10000
EMBEDDING_CACHE_TTL=86400

# ======================== 限流 ========================
RATE_LIMIT_QPM=60
RATE_LIMIT_BURST=10

# ======================== JWT ========================
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

# ======================== CORS ========================
CORS_ORIGINS=["http://localhost:5173","http://localhost:3080"]

# ======================== 监控 ========================
ENABLE_METRICS=true
METRICS_PORT=9091
LOG_LEVEL=INFO
